generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPERADMIN
}

enum LeagueRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leagues        LeagueMember[]
  predictions    Prediction[]
  createdLeagues League[] @relation("CreatedLeagues")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  logoUrl   String?
  createdAt DateTime @default(now())

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
}

model Match {
  id           String   @id @default(cuid())
  leagueId     String
  league       League   @relation(fields: [leagueId], references: [id])

  homeTeamId   String
  homeTeam     Team @relation("HomeTeam", fields: [homeTeamId], references: [id])

  awayTeamId   String
  awayTeam     Team @relation("AwayTeam", fields: [awayTeamId], references: [id])

  kickoffAt    DateTime
  lockAt       DateTime

  finalHome    Int?
  finalAway    Int?
  createdAt    DateTime @default(now())

  predictions  Prediction[]

  @@index([leagueId, kickoffAt])
}

model League {
  id           String   @id @default(cuid())
  name         String
  description  String?
  isPublic     Boolean  @default(false)
  joinCode     String   @unique
  createdById  String
  createdBy    User     @relation("CreatedLeagues", fields: [createdById], references: [id])

  pointsExact   Int @default(3)
  pointsOutcome Int @default(1)

  createdAt DateTime @default(now())

  members     LeagueMember[]
  matches     Match[]
  predictions Prediction[]
}

model LeagueMember {
  id        String     @id @default(cuid())
  leagueId  String
  userId    String
  role      LeagueRole @default(MEMBER)
  joinedAt  DateTime   @default(now())

  league League @relation(fields: [leagueId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([leagueId, userId])
}

model Prediction {
  id        String   @id @default(cuid())
  leagueId  String
  userId    String
  matchId   String

  predHome  Int
  predAway  Int

  points    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  match  Match  @relation(fields: [matchId], references: [id])

  @@unique([leagueId, userId, matchId])
  @@index([leagueId, matchId])
}
